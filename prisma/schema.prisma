  productId        String              @map("product_id")
  variantId        String?             @map("variant_id")
  quantity         Int                 @default(1)
  unitPrice        Float               @map("unit_price")
  selected         Boolean             @default(true)
  recentlyAdded    Boolean             @default(false)
  snapTitle        String?             @map("snap_title")
  snapBrand        String?             @map("snap_brand")
  snapThumbnailUrl String?             @map("snap_thumbnail_url")
  snapVariantTitle String?             @map("snap_variant_title")
  snapSku          String?             @map("snap_sku")
  snapPrice        Float?              @map("snap_price")
  createdAt        DateTime            @default(now()) @map("created_at")
  cart             ShopCart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          ShopProduct         @relation(fields: [productId], references: [id])
  variant          ShopProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@map("shop_cart_items")
}

model ShopOrder {
  id                  String          @id @default(cuid())
  orderNumber         Int             @unique @default(autoincrement()) @map("order_number")
  userId              String          @map("user_id")
  sellerId            String?         @map("seller_id")
  subtotal            Float
  shippingTotal       Float           @default(0) @map("shipping_total")
  taxTotal            Float           @default(0) @map("tax_total")
  discountTotal       Float           @default(0) @map("discount_total")
  total               Float
  status              ShopOrderStatus @default(PENDING)
  shippingAddressId   String?         @map("shipping_address_id")
  trackingNumber      String?         @map("tracking_number")
  courier             String?
  estimatedDeliveryAt DateTime?       @map("estimated_delivery_at")
  deliveredAt         DateTime?       @map("delivered_at")
  cancelledAt         DateTime?       @map("cancelled_at")
  cancelReason        String?         @map("cancel_reason")
  refundStatus        RefundStatus    @default(NONE) @map("refund_status")
  refundAmount        Float?          @map("refund_amount")
  notes               String?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  user                User            @relation(fields: [userId], references: [id])
  seller              ShopSeller?     @relation(fields: [sellerId], references: [id])
  shippingAddress     ShopAddress?    @relation(fields: [shippingAddressId], references: [id])
  items               ShopOrderItem[]
  inventoryHistory    ShopInventoryHistory[]

  @@index([userId])
  @@index([sellerId])
  @@index([status])
  @@map("shop_orders")
}

model ShopOrderItem {
  id            String              @id @default(cuid())
  orderId       String              @map("order_id")
  productId     String              @map("product_id")
  variantId     String?             @map("variant_id")
  productTitle  String              @map("product_title")   // snapshot
  variantTitle  String?             @map("variant_title")   // snapshot
  thumbnailUrl  String?             @map("thumbnail_url")   // snapshot
  quantity      Int
  unitPrice     Float               @map("unit_price")
  totalPrice    Float               @map("total_price")
  createdAt     DateTime            @default(now()) @map("created_at")
  order         ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       ShopProduct         @relation(fields: [productId], references: [id])
  variant       ShopProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("shop_order_items")
}

model ShopCoupon {
  id               String     @id @default(cuid())
  code             String     @unique
  name             String
  description      String?
  type             CouponType
  value            Float               // percentage or fixed amount
  minOrderAmount   Float?              @map("min_order_amount")
  maxDiscountAmount Float?             @map("max_discount_amount")
  maxUses          Int?                @map("max_uses")
  usedCount        Int                 @default(0) @map("used_count")
  sellerId         String?             @map("seller_id") // null = platform-wide
  startAt          DateTime?           @map("start_at")
  endAt            DateTime?           @map("end_at")
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at")
  seller           ShopSeller?         @relation(fields: [sellerId], references: [id])
  carts            ShopCart[]

  @@index([sellerId])
  @@map("shop_coupons")
}

model ShopReview {
  id           String       @id @default(cuid())
  productId    String       @map("product_id")
  userId       String       @map("user_id")
  rating       Int          // 1-5
  title        String?
  body         String?
  images       String[]     // array of image URLs
  status       ReviewStatus @default(REVIEW_PENDING)
  adminNote    String?      @map("admin_note")
  helpfulCount Int          @default(0) @map("helpful_count")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  product      ShopProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("shop_reviews")
}

model ShopCommerceNotification {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  type      String               // ORDER_PLACED, ORDER_SHIPPED, PRODUCT_APPROVED, PRICE_DROP, etc.
  title     String
  body      String?
  icon      String?
  actionUrl String?              @map("action_url")
  priority  NotificationPriority @default(NORMAL)
  read      Boolean              @default(false)
  readAt    DateTime?            @map("read_at")
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("shop_commerce_notifications")
}

model UserRole {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  role      UserRoleEnum
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model ShopInventoryHistory {
  id             String              @id @default(cuid())
  productId      String              @map("product_id")
  variantId      String?             @map("variant_id")
  changeType     InventoryChangeType @map("change_type")
  quantityBefore Int                 @map("quantity_before")
  quantityAfter  Int                 @map("quantity_after")
  quantityDelta  Int                 @map("quantity_delta")
  reason         String?
  performedBy    String?             @map("performed_by") // userId
  orderId        String?             @map("order_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  product        ShopProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ShopProductVariant? @relation(fields: [variantId], references: [id])
  order          ShopOrder?          @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@map("shop_inventory_history")
}

model ShopAnalyticsEvent {
  id         String             @id @default(cuid())
  eventType  AnalyticsEventType @map("event_type")
  productId  String?            @map("product_id")
  categoryId String?            @map("category_id")
  sellerId   String?            @map("seller_id")
  userId     String?            @map("user_id")
  sessionId  String?            @map("session_id")
  metadata   Json?
  revenue    Float?
  createdAt  DateTime           @default(now()) @map("created_at")
  product    ShopProduct?       @relation(fields: [productId], references: [id])

  @@index([eventType])
  @@index([productId])
  @@index([createdAt])
  @@map("shop_analytics_events")
}

model ShopCartAuditLog {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  userId    String?  @map("user_id")
  action    String   // ADD_ITEM, REMOVE_ITEM, UPDATE_QTY, APPLY_COUPON, REMOVE_COUPON, CHECKOUT, MOVE_WISHLIST
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("shop_cart_audit_logs")
}

model ShopAdminSetting {
  key       String   @id
  value     String   // JSON string or plain text value
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_admin_settings")
}
