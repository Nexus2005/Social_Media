model ShopProduct {
  id                String              @id @default(cuid())
  title             String
  slug              String              @unique
  description       String?
  shortDescription  String?             @map("short_description")
  specifications    Json?               // structured specs
  features          Json?               // feature bullet points
  price             Float
  salePrice         Float?              @map("sale_price")
  costPrice         Float?              @map("cost_price")
  sku               String?             @unique
  barcode           String?
  weight            Float?              // in grams
  width             Float?              // cm
  height            Float?              // cm
  length            Float?              // cm
  brandId           String?             @map("brand_id")
  categoryId        String?             @map("category_id")
  sellerId          String?             @map("seller_id")
  status            ShopProductStatus   @default(DRAFT)
  featured          Boolean             @default(false)
  trending          Boolean             @default(false)
  seoTitle          String?             @map("seo_title")
  seoDescription    String?             @map("seo_description")
  seoKeywords       String?             @map("seo_keywords")
  metaData          Json?               @map("meta_data")
  viewCount         Int                 @default(0) @map("view_count")
  salesCount        Int                 @default(0) @map("sales_count")
  publishedAt       DateTime?           @map("published_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  brand             Brand?              @relation(fields: [brandId], references: [id])
  category          ShopCategory?       @relation(fields: [categoryId], references: [id])
  seller            ShopSeller?         @relation(fields: [sellerId], references: [id])
  images            ShopProductImage[]
  variants          ShopProductVariant[]
  collections       ShopCollectionProduct[]
  deals             ShopDeal[]
  creatorPicks      ShopCreatorPick[]
  wishlists         ShopWishlist[]
  cartItems         ShopCartItem[]
  orderItems        ShopOrderItem[]
  reviews           ShopReview[]
  inventoryHistory  ShopInventoryHistory[]
  analyticsEvents   ShopAnalyticsEvent[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("shop_products")
}

