generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                    String              @id
  username              String              @unique
  displayName           String
  email                 String?             @unique
  passwordHash          String?
  googleId              String?             @unique
  avatarUrl             String?
  bio                   String?
  createdAt             DateTime            @default(now())
  birthDate             DateTime?
  headerBannerUrl       String?
  location              String?
  professionalCategory  String?
  websiteUrl            String?
  verified              Boolean             @default(false)
  role                  String              @default("USER")
  bookmarks             Bookmark[]
  commentLikes          CommentLike[]
  comments              Comment[]
  drafts                DraftPost[]
  following             Follow[]            @relation("Following")
  followers             Follow[]            @relation("Followers")
  likes                 Like[]
  issuedNotifications   Notification[]      @relation("Issuer")
  receivedNotifications Notification[]      @relation("Recipient")
  pollVotes             PollVote[]
  mentions              PostMention[]
  views                 PostView[]
  posts                 Post[]
  productCollections    ProductCollection[]
  reposts               Repost[]
  collections           SavedCollection[]
  sessions              Session[]
  stories               Story[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String                @id @default(cuid())
  content             String
  userId              String
  createdAt           DateTime              @default(now())
  altText             String?
  audience            String                @default("PUBLIC")
  collaborators       Json?
  disableComments     Boolean               @default(false)
  hideLikes           Boolean               @default(false)
  location            String?
  tags                Json?
  isPinned            Boolean               @default(false)
  quotedPostId        String?
  bookmarks           Bookmark[]
  comments            Comment[]
  detectedObjects     DetectedObject[]
  detectedProducts    DetectedProduct[]
  likes               Like[]
  linkedNotifications Notification[]
  poll                Poll?
  attachments         Media[]
  mentions            PostMention[]
  views               PostView[]
  quotedPost          Post?                 @relation("QuotePost", fields: [quotedPostId], references: [id])
  quotedIn            Post[]                @relation("QuotePost")
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reposts             Repost[]
  collectionItems     SavedCollectionItem[]
  videoJob            VideoProcessingJob?

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  mediaType MediaType @map("type")
  url       String
  createdAt DateTime  @default(now())
  height    Int?
  width     Int?
  post      Post?     @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([mediaType])
  @@map("post_media")
}

model Comment {
  id              String        @id @default(cuid())
  content         String
  userId          String
  postId          String
  createdAt       DateTime      @default(now())
  parentCommentId String?
  likes           CommentLike[]
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]     @relation("CommentReplies")
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
  @@map("comments")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([issuerId])
  @@index([postId])
  @@map("notifications")
}

model Story {
  id        String    @id @default(cuid())
  userId    String
  mediaUrl  String
  mediaType MediaType
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("stories")
}

model DetectedObject {
  id        String   @id @default(cuid())
  postId    String
  name      String
  box       Json
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("detected_objects")
}

model DetectedProduct {
  id                      String                  @id @default(cuid())
  postId                  String                  @map("post_id")
  label                   String
  category                String
  box                     Json?
  thumbnailUrl            String?                 @map("thumbnail_url")
  createdAt               DateTime                @default(now()) @map("created_at")
  color                   String?
  confidence              Float?
  dominantColor           String?                 @map("dominant_color")
  frameTimestamp          Float?                  @map("frame_timestamp")
  productEmbedding        Json?                   @map("product_embedding")
  sourceFrameUrl          String?                 @map("source_frame_url")
  completenessScore       Float?                  @map("completeness_score")
  gender                  String?
  isVerifiedMatch         Boolean                 @default(false) @map("is_verified_match")
  keywords                String[]                @default([])
  material                String?
  season                  String?
  shoppingMatchConfidence Float?                  @map("shopping_match_confidence")
  style                   String?
  visionConfidence        Float?                  @map("vision_confidence")
  post                    Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  collectionItems         ProductCollectionItem[]
  matches                 ShoppingMatch[]

  @@index([postId])
  @@map("detected_products")
}

model ShoppingMatch {
  id                String          @id @default(cuid())
  detectedProductId String          @map("detected_product_id")
  title             String
  price             String
  currency          String          @default("INR")
  sourceStore       String          @map("source_store")
  productUrl        String          @map("product_url")
  imageUrl          String?         @map("image_url")
  createdAt         DateTime        @default(now()) @map("created_at")
  affiliateUrl      String?         @map("affiliate_url")
  clickCount        Int             @default(0) @map("click_count")
  priceHistories    PriceHistory[]
  detectedProduct   DetectedProduct @relation(fields: [detectedProductId], references: [id], onDelete: Cascade)

  @@index([detectedProductId])
  @@map("shopping_matches")
}

model VideoProcessingJob {
  id          String    @id @default(cuid())
  postId      String    @unique @map("post_id")
  status      String    @default("pending")
  retryCount  Int       @default(0) @map("retry_count")
  lastRetryAt DateTime? @map("last_retry_at")
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("video_processing_jobs")
}

model VideoProcessingLog {
  id                   String   @id @default(cuid())
  videoId              String   @map("video_id")
  processingTime       Float?   @map("processing_time")
  visionCalls          Int      @default(0) @map("vision_calls")
  openrouterCalls      Int      @default(0) @map("openrouter_calls")
  nvidiaCalls          Int      @default(0) @map("nvidia_calls")
  serpapiCalls         Int      @default(0) @map("serpapi_calls")
  processingCost       Float    @default(0.0) @map("processing_cost")
  visionResults        Json?    @map("vision_results")
  openrouterResults    Json?    @map("openrouter_results")
  nvidiaFallbackUsage  Boolean  @default(false) @map("nvidia_fallback_usage")
  shoppingResultsCount Int      @default(0) @map("shopping_results_count")
  errorMessages        String?  @map("error_messages")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("video_processing_logs")
}

model Poll {
  id        String       @id @default(cuid())
  postId    String       @unique
  expiresAt DateTime
  options   PollOption[]
  votes     PollVote[]
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("polls")
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@map("poll_options")
}

model PollVote {
  id       String     @id @default(cuid())
  optionId String
  userId   String
  pollId   String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
  @@map("poll_votes")
}

model PostView {
  id            String   @id @default(cuid())
  postId        String
  userId        String?
  ip            String?
  watchDuration Int?
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_views")
}

model Repost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("reposts")
}

model PostMention {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_mentions")
}

model DraftPost {
  id          String   @id @default(cuid())
  userId      String
  content     String?
  attachments Json?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("draft_posts")
}

model SavedCollection {
  id        String                @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime              @default(now())
  items     SavedCollectionItem[]
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("saved_collections")
}

model SavedCollectionItem {
  id           String          @id @default(cuid())
  collectionId String
  postId       String
  createdAt    DateTime        @default(now())
  collection   SavedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  post         Post            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([collectionId, postId])
  @@map("saved_collection_items")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model PriceHistory {
  id              String        @id @default(cuid())
  shoppingMatchId String        @map("shopping_match_id")
  price           Float
  capturedAt      DateTime      @default(now()) @map("captured_at")
  shoppingMatch   ShoppingMatch @relation(fields: [shoppingMatchId], references: [id], onDelete: Cascade)

  @@map("price_histories")
}

model ProductCollection {
  id        String                  @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime                @default(now()) @map("created_at")
  items     ProductCollectionItem[]
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("product_collections")
}

model ProductCollectionItem {
  id           String            @id @default(cuid())
  collectionId String            @map("collection_id")
  productId    String            @map("product_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      DetectedProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("product_collection_items")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  LIKE
  FOLLOW
  COMMENT
  REPOST
  QUOTE
  REPLY
  MENTION
}
