generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                    String              @id
  username              String              @unique
  displayName           String
  email                 String?             @unique
  passwordHash          String?
  googleId              String?             @unique
  avatarUrl             String?
  bio                   String?
  createdAt             DateTime            @default(now())
  birthDate             DateTime?
  headerBannerUrl       String?
  location              String?
  professionalCategory  String?
  websiteUrl            String?
  verified              Boolean             @default(false)
  role                  String              @default("USER")
  bookmarks             Bookmark[]
  commentLikes          CommentLike[]
  comments              Comment[]
  drafts                DraftPost[]
  following             Follow[]            @relation("Following")
  followers             Follow[]            @relation("Followers")
  likes                 Like[]
  issuedNotifications   Notification[]      @relation("Issuer")
  receivedNotifications Notification[]      @relation("Recipient")
  pollVotes             PollVote[]
  mentions              PostMention[]
  views                 PostView[]
  posts                 Post[]
  productCollections    ProductCollection[]
  reposts               Repost[]
  collections           SavedCollection[]
  sessions              Session[]
  stories               Story[]
  closeFriends          CloseFriend[]       @relation("UserCloseFriends")
  designatedAsCloseFriend CloseFriend[]     @relation("FriendCloseFriends")
  sentInstants          Instant[]           @relation("SentInstants")
  instantViews          InstantView[]
  isPrivate                Boolean             @default(false)
  pinnedContent            PinnedContent[]
  unreadNotificationCount  Int                 @default(0)
  notificationPreference   NotificationPreference?

  // Messaging Preferences V5
  chatPins                 ChatPin[]
  chatArchives             ChatArchive[]
  chatMutes                ChatMute[]
  conversationSettings     ConversationSettings[]

  // Spots V3 Creator Commerce System
  creatorProducts       DetectedProduct[]   @relation("CreatorProducts")
  productEvents         ProductEvent[]
  campaigns             Campaign[]
  assignedAssignments   ProductAssignment[] @relation("AssignedProducts")
  recentLocations       RecentLocation[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  status      FollowStatus @default(ACCEPTED)
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String                @id @default(cuid())
  content             String
  userId              String
  createdAt           DateTime              @default(now())
  altText             String?
  audience            String                @default("PUBLIC")
  collaborators       Json?
  disableComments     Boolean               @default(false)
  hideLikes           Boolean               @default(false)
  location            String?
  locationName        String?               @map("location_name")
  locationCity        String?               @map("location_city")
  locationState       String?               @map("location_state")
  locationCountry     String?               @map("location_country")
  locationDisplay     String?               @map("location_display")
  latitude            Float?
  longitude           Float?
  tags                Json?
  contentFormat       ContentFormat         @default(FEED)
  quotedPostId        String?
  bookmarks           Bookmark[]
  comments            Comment[]
  pinnedContent       PinnedContent[]
  detectedObjects     DetectedObject[]
  detectedProducts    DetectedProduct[]
  likes               Like[]
  linkedNotifications Notification[]
  poll                Poll?
  attachments         Media[]
  mentions            PostMention[]
  views               PostView[]
  quotedPost          Post?                 @relation("QuotePost", fields: [quotedPostId], references: [id])
  quotedIn            Post[]                @relation("QuotePost")
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reposts             Repost[]
  collectionItems     SavedCollectionItem[]
  videoJob            VideoProcessingJob?

  // Spots V3 Creator Commerce System
  assignments         ProductAssignment[]

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  mediaType MediaType @map("type")
  url       String
  createdAt DateTime  @default(now())
  height    Int?
  width     Int?
  post      Post?     @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([mediaType])
  @@map("post_media")
}

model Comment {
  id              String        @id @default(cuid())
  content         String
  userId          String
  postId          String
  createdAt       DateTime      @default(now())
  parentCommentId String?
  likes           CommentLike[]
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]     @relation("CommentReplies")
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
  @@map("comments")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  metadata    Json?
  deepLink    String?
  createdAt   DateTime         @default(now())
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([issuerId])
  @@index([postId])
  @@index([recipientId, read])
  @@map("notifications")
}

model Story {
  id        String    @id @default(cuid())
  userId    String
  mediaUrl  String
  mediaType MediaType
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("stories")
}

model DetectedObject {
  id        String   @id @default(cuid())
  postId    String
  name      String
  box       Json
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("detected_objects")
}

model DetectedProduct {
  id                      String                  @id @default(cuid())
  postId                  String                  @map("post_id")
  label                   String
  category                String
  box                     Json?
  thumbnailUrl            String?                 @map("thumbnail_url")
  createdAt               DateTime                @default(now()) @map("created_at")
  color                   String?
  confidence              Float?
  dominantColor           String?                 @map("dominant_color")
  frameTimestamp          Float?                  @map("frame_timestamp")
  productEmbedding        Json?                   @map("product_embedding")
  sourceFrameUrl          String?                 @map("source_frame_url")
  completenessScore       Float?                  @map("completeness_score")
  gender                  String?
  isVerifiedMatch         Boolean                 @default(false) @map("is_verified_match")
  keywords                String[]                @default([])
  material                String?
  season                  String?
  shoppingMatchConfidence Float?                  @map("shopping_match_confidence")
  style                   String?
  visionConfidence        Float?                  @map("vision_confidence")
  post                    Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  collectionItems         ProductCollectionItem[]
  matches                 ShoppingMatch[]

  // Spots V3 Creator Commerce System
  creatorId               String?                 @map("creator_id")
  images                  String[]                @default([]) @map("images")
  brand                   String?                 @map("brand")
  description             String?                 @map("description")
  viewsCount              Int                     @default(0) @map("views_count")
  drawerOpensCount        Int                     @default(0) @map("drawer_opens_count")
  productClicksCount      Int                     @default(0) @map("product_clicks_count")
  retailerClicksCount     Int                     @default(0) @map("retailer_clicks_count")
  wishlistSavesCount      Int                     @default(0) @map("wishlist_saves_count")

  creator                 User?                   @relation("CreatorProducts", fields: [creatorId], references: [id], onDelete: SetNull)
  events                  ProductEvent[]
  collections             ProductCollection[]
  assignments             ProductAssignment[]

  @@index([postId])
  @@map("detected_products")
}

model ShoppingMatch {
  id                String          @id @default(cuid())
  detectedProductId String          @map("detected_product_id")
  title             String
  price             String
  currency          String          @default("INR")
  sourceStore       String          @map("source_store")
  productUrl        String          @map("product_url")
  imageUrl          String?         @map("image_url")
  createdAt         DateTime        @default(now()) @map("created_at")
  affiliateUrl      String?         @map("affiliate_url")
  clickCount        Int             @default(0) @map("click_count")
  priceHistories    PriceHistory[]
  detectedProduct   DetectedProduct @relation(fields: [detectedProductId], references: [id], onDelete: Cascade)

  // Spots V3 Creator Commerce System
  merchantId        String?             @map("merchant_id")
  deliveryText      String?             @map("delivery_text")
  availability      ProductAvailability @default(IN_STOCK) @map("availability")
  retailerSource    RetailerSource      @default(AI_MATCH) @map("retailer_source")
  trackingCode      String?             @map("tracking_code")
  directUrl         String?             @map("direct_url")

  merchant          Merchant?           @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([detectedProductId])
  @@map("shopping_matches")
}

model VideoProcessingJob {
  id          String    @id @default(cuid())
  postId      String    @unique @map("post_id")
  status      String    @default("pending")
  retryCount  Int       @default(0) @map("retry_count")
  lastRetryAt DateTime? @map("last_retry_at")
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("video_processing_jobs")
}

model VideoProcessingLog {
  id                   String   @id @default(cuid())
  videoId              String   @map("video_id")
  processingTime       Float?   @map("processing_time")
  visionCalls          Int      @default(0) @map("vision_calls")
  openrouterCalls      Int      @default(0) @map("openrouter_calls")
  nvidiaCalls          Int      @default(0) @map("nvidia_calls")
  serpapiCalls         Int      @default(0) @map("serpapi_calls")
  processingCost       Float    @default(0.0) @map("processing_cost")
  visionResults        Json?    @map("vision_results")
  openrouterResults    Json?    @map("openrouter_results")
  nvidiaFallbackUsage  Boolean  @default(false) @map("nvidia_fallback_usage")
  shoppingResultsCount Int      @default(0) @map("shopping_results_count")
  errorMessages        String?  @map("error_messages")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("video_processing_logs")
}

model Poll {
  id        String       @id @default(cuid())
  postId    String       @unique
  expiresAt DateTime
  options   PollOption[]
  votes     PollVote[]
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("polls")
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@map("poll_options")
}

model PollVote {
  id       String     @id @default(cuid())
  optionId String
  userId   String
  pollId   String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
  @@map("poll_votes")
}

model PostView {
  id            String   @id @default(cuid())
  postId        String
  userId        String?
  ip            String?
  watchDuration Int?
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_views")
}

model Repost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("reposts")
}

model PostMention {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_mentions")
}

model DraftPost {
  id          String   @id @default(cuid())
  userId      String
  content     String?
  attachments Json?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("draft_posts")
}

model SavedCollection {
  id        String                @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime              @default(now())
  items     SavedCollectionItem[]
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("saved_collections")
}

model SavedCollectionItem {
  id           String          @id @default(cuid())
  collectionId String
  postId       String
  createdAt    DateTime        @default(now())
  collection   SavedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  post         Post            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([collectionId, postId])
  @@map("saved_collection_items")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model PriceHistory {
  id              String        @id @default(cuid())
  shoppingMatchId String        @map("shopping_match_id")
  price           Float
  capturedAt      DateTime      @default(now()) @map("captured_at")
  shoppingMatch   ShoppingMatch @relation(fields: [shoppingMatchId], references: [id], onDelete: Cascade)

  @@map("price_histories")
}

model ProductCollection {
  id        String                  @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime                @default(now()) @map("created_at")
  items     ProductCollectionItem[]
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Spots V3 Creator Commerce System
  description String?                 @map("description")
  coverImage  String?                 @map("cover_image")
  isPublic    Boolean                 @default(true) @map("is_public")
  featured    Boolean                 @default(false) @map("featured")
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at")
  products    DetectedProduct[]

  @@unique([userId, name])
  @@map("product_collections")
}

model ProductCollectionItem {
  id           String            @id @default(cuid())
  collectionId String            @map("collection_id")
  productId    String            @map("product_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      DetectedProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("product_collection_items")
}

// Spots V3 Creator Commerce System Models

model ProductAssignment {
  id                  String             @id @default(cuid())
  postId              String             @map("post_id")
  productId           String             @map("product_id")
  assignedById        String?            @map("assigned_by_id")
  displayOrder        Int                @default(0) @map("display_order")
  featured            Boolean            @default(false) @map("featured")
  status              ProductStatus      @default(PENDING_REVIEW) @map("status")
  verificationSource  VerificationSource @default(AI_DETECTED) @map("verification_source")
  sourceType          SourceType         @default(AI_DETECTED) @map("source_type")
  manuallyAssigned    Boolean            @default(false) @map("manually_assigned")
  reviewReason        String?            @map("review_reason")
  aiConfidence        Float?             @map("ai_confidence")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")
  productType         ProductType        @default(FEATURED) @map("product_type")
  productSource       ProductSource      @default(AI) @map("product_source")

  post                Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  product             DetectedProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  assignedBy          User?              @relation("AssignedProducts", fields: [assignedById], references: [id], onDelete: SetNull)
  events              ProductEvent[]

  @@unique([postId, productId])
  @@map("product_assignments")
}

model ProductEvent {
  id            String            @id @default(cuid())
  productId     String            @map("product_id")
  assignmentId  String?           @map("assignment_id")
  userId        String?           @map("user_id")
  eventType     ProductEventType  @map("event_type")
  metadata      Json?             @map("metadata")
  createdAt     DateTime          @default(now()) @map("created_at")

  product       DetectedProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  assignment    ProductAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("product_events")
}

model Merchant {
  id              String          @id @default(cuid())
  name            String          @unique
  logoUrl         String?         @map("logo_url")
  rating          Float?
  reviews         Int?
  createdAt       DateTime        @default(now()) @map("created_at")
  shoppingMatches ShoppingMatch[]

  @@map("merchants")
}

model Brand {
  id          String      @id @default(cuid())
  name        String      @unique
  logoUrl     String?     @map("logo_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  campaigns   Campaign[]

  @@map("brands")
}

model Campaign {
  id               String         @id @default(cuid())
  brandId          String         @map("brand_id")
  creatorId        String         @map("creator_id")
  name             String
  status           CampaignStatus @default(DRAFT)
  commissionRate   Float?         @default(0) @map("commission_rate")
  commissionEarned Float?         @default(0) @map("commission_earned")
  createdAt        DateTime       @default(now()) @map("created_at")

  brand            Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator          User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("campaigns")
}

// Spots V3 Commerce System Enums

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  // Social interactions
  LIKE
  FOLLOW
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  COMMENT
  COMMENT_LIKE
  REPOST
  QUOTE
  REPLY
  MENTION
  STORY_MENTION
  SHARE
  COLLECTION_SAVE

  // Commerce events
  PRODUCT_ORDER
  PRODUCT_SHIPPED
  PRODUCT_DELIVERED
  PRODUCT_PRICE_DROP
  PRODUCT_BACK_IN_STOCK
  PRODUCT_APPROVED
  POST_APPROVED

  // Social groups
  COLLECTION_INVITE
  GROUP_INVITE
  MESSAGE

  // Account & Security
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SECURITY_ALERT
  PASSWORD_CHANGED
  SYSTEM
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
  PENDING_REVIEW
}

enum VerificationSource {
  AI_DETECTED
  CREATOR_APPROVED
  CREATOR_ADDED
  ADMIN_VERIFIED
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
}

enum RetailerSource {
  AI_MATCH
  CREATOR_MATCH
  MANUAL
}

enum ProductEventType {
  VIEW
  DRAWER_OPEN
  PRODUCT_CLICK
  RETAILER_CLICK
  SAVE
}

enum SourceType {
  AI_DETECTED
  CREATOR_MANUAL
  BRAND_PARTNERSHIP
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProductType {
  FEATURED
  SIMILAR
}

enum ProductSource {
  AI
  MANUAL
  IMPORTED
}

model LocationCache {
  id          String    @id @default(cuid())
  latRounded  Float     @map("lat_rounded")
  lngRounded  Float     @map("lng_rounded")
  osmId       String?   @map("osm_id")
  displayName String    @map("display_name")
  city        String?
  state       String?
  country     String?
  expiresAt   DateTime  @map("expires_at")

  @@unique([latRounded, lngRounded])
  @@map("location_cache")
}

model RecentLocation {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  locationName String   @map("location_name")
  city         String?
  state        String?
  country      String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recent_locations")
}

model PinnedContent {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  position  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, position])
  @@map("pinned_contents")
}

enum ContentFormat {
  FEED
  SPOT
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model NotificationPreference {
  userId    String  @id
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Social
  likes     Boolean @default(true)
  comments  Boolean @default(true)
  mentions  Boolean @default(true)
  follows   Boolean @default(true)
  reposts   Boolean @default(true)
  quotes    Boolean @default(true)
  shares    Boolean @default(true)

  // Commerce
  orders    Boolean @default(true)
  products  Boolean @default(true)

  // System
  security  Boolean @default(true)
  system    Boolean @default(true)
  messages  Boolean @default(true)

  @@map("notification_preferences")
}

model ChatPin {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  channelId String   @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("chat_pins")
}

model ChatArchive {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  channelId String   @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("chat_archives")
}

model ChatMute {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  channelId String    @map("channel_id")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("chat_mutes")
}

model ConversationSettings {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  channelId     String    @map("channel_id")
  wallpaper     String?
  lastClearedAt DateTime? @map("last_cleared_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("conversation_settings")
}

model CloseFriend {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation("UserCloseFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendCloseFriends", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("close_friends")
}

model Instant {
  id        String        @id @default(cuid())
  senderId  String        @map("sender_id")
  mediaUrl  String        @map("media_url")
  audience  String        @default("FRIENDS") // "FRIENDS" or "CLOSE_FRIENDS"
  createdAt DateTime      @default(now()) @map("created_at")
  sender    User          @relation("SentInstants", fields: [senderId], references: [id], onDelete: Cascade)
  views     InstantView[]

  @@index([senderId])
  @@index([createdAt])
  @@map("instants")
}

model InstantView {
  id        String   @id @default(cuid())
  instantId String   @map("instant_id")
  userId    String   @map("user_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  instant   Instant  @relation(fields: [instantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instantId, userId])
  @@map("instant_views")
}


