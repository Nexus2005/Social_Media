generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "relationJoins"]
  output          = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                      String                  @id
  username                String                  @unique
  displayName             String
  email                   String?                 @unique
  passwordHash            String?
  googleId                String?                 @unique
  avatarUrl               String?
  bio                     String?
  createdAt               DateTime                @default(now())
  birthDate               DateTime?
  headerBannerUrl         String?
  location                String?
  professionalCategory    String?
  websiteUrl              String?
  verified                Boolean                 @default(false)
  role                    String                  @default("USER")
  isPrivate               Boolean                 @default(false)
  unreadNotificationCount Int                     @default(0)
  bookmarks               Bookmark[]
  campaigns               Campaign[]
  chatArchives            ChatArchive[]
  chatMutes               ChatMute[]
  chatPins                ChatPin[]
  designatedAsCloseFriend CloseFriend[]           @relation("FriendCloseFriends")
  closeFriends            CloseFriend[]           @relation("UserCloseFriends")
  commentBookmarks        CommentBookmark[]
  commentLikes            CommentLike[]
  commentReports          CommentReport[]
  commentReposts          CommentRepost[]
  comments                Comment[]
  conversationSettings    ConversationSettings[]
  creatorProducts         DetectedProduct[]       @relation("CreatorProducts")
  drafts                  DraftPost[]
  following               Follow[]                @relation("Following")
  followers               Follow[]                @relation("Followers")
  instantViews            InstantView[]
  sentInstants            Instant[]               @relation("SentInstants")
  likes                   Like[]
  mutedConversations      MutedConversation[]
  notificationPreference  NotificationPreference?
  issuedNotifications     Notification[]          @relation("Issuer")
  receivedNotifications   Notification[]          @relation("Recipient")
  pinnedContent           PinnedContent[]
  pollVotes               PollVote[]
  mentions                PostMention[]
  views                   PostView[]
  posts                   Post[]
  assignedAssignments     ProductAssignment[]     @relation("AssignedProducts")
  productCollections      ProductCollection[]
  productEvents           ProductEvent[]
  recentLocations         RecentLocation[]
  reposts                 Repost[]
  collections             SavedCollection[]
  sessions                Session[]
  stories                 Story[]
  storyLikes              StoryLike[]
  storyViews              StoryView[]
  blockedBy               UserBlock[]             @relation("UserBlockedBy")
  blocks                  UserBlock[]             @relation("UserBlocks")
  mutedBy                 UserMute[]              @relation("UserMutedBy")
  mutes                   UserMute[]              @relation("UserMutes")
  userRoles               UserRole[]
  shopOrders              ShopOrder[]
  shopReviews             ShopReview[]
  shopCarts               ShopCart[]
  shopNotifications       ShopCommerceNotification[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  status      FollowStatus @default(ACCEPTED)
  follower    User         @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User         @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@map("follows")
}

model Post {
  id                  String                @id @default(cuid())
  content             String
  userId              String
  createdAt           DateTime              @default(now())
  altText             String?
  audience            String                @default("PUBLIC")
  collaborators       Json?
  disableComments     Boolean               @default(false)
  hideLikes           Boolean               @default(false)
  location            String?
  locationName        String?               @map("location_name")
  locationCity        String?               @map("location_city")
  locationState       String?               @map("location_state")
  locationCountry     String?               @map("location_country")
  locationDisplay     String?               @map("location_display")
  latitude            Float?
  longitude           Float?
  tags                Json?
  contentFormat       ContentFormat         @default(FEED)
  quotedPostId        String?
  bookmarks           Bookmark[]
  reports             CommentReport[]
  comments            Comment[]
  detectedObjects     DetectedObject[]
  detectedProducts    DetectedProduct[]
  detectionSessions   DetectionSession[]
  likes               Like[]
  linkedNotifications Notification[]
  pinnedContent       PinnedContent[]
  poll                Poll?
  attachments         Media[]
  mentions            PostMention[]
  views               PostView[]
  quotedPost          Post?                 @relation("QuotePost", fields: [quotedPostId], references: [id])
  quotedIn            Post[]                @relation("QuotePost")
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments         ProductAssignment[]
  reposts             Repost[]
  collectionItems     SavedCollectionItem[]
  videoJob            VideoProcessingJob?

  @@index([userId])
  @@index([createdAt])
  @@index([contentFormat])
  @@index([userId, createdAt])
  @@index([quotedPostId])
  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  mediaType MediaType @map("type")
  url       String
  createdAt DateTime  @default(now())
  height    Int?
  width     Int?
  post      Post?     @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([mediaType])
  @@map("post_media")
}

model Comment {
  id                 String              @id @default(cuid())
  content            String
  userId             String
  postId             String
  createdAt          DateTime            @default(now())
  parentCommentId    String?
  viewsCount         Int                 @default(0) @map("views_count")
  bookmarks          CommentBookmark[]
  likes              CommentLike[]
  reports            CommentReport[]
  reposts            CommentRepost[]
  parentComment      Comment?            @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies            Comment[]           @relation("CommentReplies")
  post               Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutedConversations MutedConversation[]

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
  @@index([postId, createdAt])
  @@map("comments")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  createdAt   DateTime         @default(now())
  issuerId    String
  postId      String?
  read        Boolean          @default(false)
  recipientId String
  deepLink    String?
  metadata    Json?
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([issuerId])
  @@index([postId])
  @@index([recipientId, read])
  @@map("notifications")
}

model Story {
  id        String      @id @default(cuid())
  userId    String
  mediaUrl  String
  mediaType MediaType
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     StoryLike[]
  views     StoryView[]

  @@index([userId])
  @@index([createdAt])
  @@map("stories")
}

model DetectedObject {
  id        String   @id @default(cuid())
  postId    String
  name      String
  box       Json
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("detected_objects")
}

model DetectedProduct {
  id                      String                  @id @default(cuid())
  postId                  String                  @map("post_id")
  label                   String
  category                String
  box                     Json?
  thumbnailUrl            String?                 @map("thumbnail_url")
  createdAt               DateTime                @default(now()) @map("created_at")
  color                   String?
  confidence              Float?
  dominantColor           String?                 @map("dominant_color")
  frameTimestamp          Float?                  @map("frame_timestamp")
  productEmbedding        Json?                   @map("product_embedding")
  sourceFrameUrl          String?                 @map("source_frame_url")
  completenessScore       Float?                  @map("completeness_score")
  gender                  String?
  isVerifiedMatch         Boolean                 @default(false) @map("is_verified_match")
  keywords                String[]                @default([])
  material                String?
  season                  String?
  shoppingMatchConfidence Float?                  @map("shopping_match_confidence")
  style                   String?
  visionConfidence        Float?                  @map("vision_confidence")
  creatorId               String?                 @map("creator_id")
  images                  String[]                @default([]) @map("images")
  brand                   String?                 @map("brand")
  description             String?                 @map("description")
  viewsCount              Int                     @default(0) @map("views_count")
  drawerOpensCount        Int                     @default(0) @map("drawer_opens_count")
  productClicksCount      Int                     @default(0) @map("product_clicks_count")
  retailerClicksCount     Int                     @default(0) @map("retailer_clicks_count")
  wishlistSavesCount      Int                     @default(0) @map("wishlist_saves_count")
  boundingBox             Json?                   @map("bounding_box")
  confidenceBreakdown     Json?                   @map("confidence_breakdown")
  cropImageUrl            String?                 @map("crop_image_url")
  cropQualityScore        Float?                  @map("crop_quality_score")
  detectedBarcode         String?                 @map("detected_barcode")
  detectedLogo            String?                 @map("detected_logo")
  detectionConfidence     Float?                  @map("detection_confidence")
  detectionSessionId      String?                 @map("detection_session_id")
  frameAppearances        Int                     @default(1) @map("frame_appearances")
  marketplaceConfidence   Float?                  @map("marketplace_confidence")
  ocrText                 String?                 @map("ocr_text")
  resolvedQueries         String[]                @default([]) @map("resolved_queries")
  trackingId              String?                 @map("tracking_id")
  verificationScore       Float?                  @map("verification_score")
  visualEmbedding         Json?                   @map("visual_embedding")
  canonicalProductId      String?                 @map("canonical_product_id")
  canonicalProduct        CanonicalProduct?       @relation(fields: [canonicalProductId], references: [id])
  creator                 User?                   @relation("CreatorProducts", fields: [creatorId], references: [id])
  post                    Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  assignments             ProductAssignment[]
  collectionItems         ProductCollectionItem[]
  events                  ProductEvent[]
  timeline                ProductTimeline[]
  matches                 ShoppingMatch[]
  collections             ProductCollection[]     @relation("DetectedProductToProductCollection")

  @@index([postId])
  @@map("detected_products")
}

model ShoppingMatch {
  id                String              @id @default(cuid())
  detectedProductId String              @map("detected_product_id")
  title             String
  price             String
  currency          String              @default("INR")
  sourceStore       String              @map("source_store")
  productUrl        String              @map("product_url")
  imageUrl          String?             @map("image_url")
  createdAt         DateTime            @default(now()) @map("created_at")
  affiliateUrl      String?             @map("affiliate_url")
  clickCount        Int                 @default(0) @map("click_count")
  merchantId        String?             @map("merchant_id")
  deliveryText      String?             @map("delivery_text")
  availability      ProductAvailability @default(IN_STOCK) @map("availability")
  retailerSource    RetailerSource      @default(AI_MATCH) @map("retailer_source")
  trackingCode      String?             @map("tracking_code")
  directUrl         String?             @map("direct_url")
  cachedAt          DateTime?           @map("cached_at")
  categoryPath      String?             @map("category_path")
  cleanedTitle      String?             @map("cleaned_title")
  condition         String?             @default("New")
  discountPercent   Float?              @map("discount_percent")
  estimatedDelivery String?             @map("estimated_delivery")
  features          String[]            @default([])
  galleryImageUrls  String[]            @default([]) @map("gallery_image_urls")
  highlights        String[]            @default([])
  manufacturer      String?
  matchBrand        String?             @map("match_brand")
  matchDescription  String?             @map("match_description")
  modelNumber       String?             @map("model_number")
  originalPrice     String?             @map("original_price")
  rating            Float?
  returnPolicy      String?             @map("return_policy")
  reviewCount       Int?                @map("review_count")
  sellerName        String?             @map("seller_name")
  sellerRating      Float?              @map("seller_rating")
  sellerReviews     Int?                @map("seller_reviews")
  shippingCost      String?             @map("shipping_cost")
  sku               String?
  specifications    Json?               @map("specifications")
  stockAvailability String?             @map("stock_availability")
  upc               String?
  verificationScore Float?              @map("verification_score")
  warranty          String?
  rawPayload        Json?               @map("raw_payload")
  priceHistories    PriceHistory[]
  variants          ProductVariant[]
  detectedProduct   DetectedProduct     @relation(fields: [detectedProductId], references: [id], onDelete: Cascade)
  merchant          Merchant?           @relation(fields: [merchantId], references: [id])

  @@index([detectedProductId])
  @@map("shopping_matches")
}

model CanonicalProduct {
  id               String            @id @default(cuid())
  brand            String
  modelLine        String            @map("model_line")
  subcategory      String
  canonicalTitle   String            @unique @map("canonical_title")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  detectedProducts DetectedProduct[]

  @@map("canonical_products")
}

model MarketplaceSearchCache {
  id              String   @id @default(cuid())
  query           String
  normalizedQuery String   @map("normalized_query")
  marketplace     String
  country         String   @default("US")
  currency        String   @default("USD")
  language        String   @default("en")
  results         Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([query, marketplace, country, currency, language])
  @@map("marketplace_search_caches")
}

model VideoProcessingJob {
  id          String    @id @default(cuid())
  postId      String    @unique @map("post_id")
  status      String    @default("pending")
  retryCount  Int       @default(0) @map("retry_count")
  lastRetryAt DateTime? @map("last_retry_at")
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("video_processing_jobs")
}

model VideoProcessingLog {
  id                   String   @id @default(cuid())
  videoId              String   @map("video_id")
  processingTime       Float?   @map("processing_time")
  visionCalls          Int      @default(0) @map("vision_calls")
  openrouterCalls      Int      @default(0) @map("openrouter_calls")
  nvidiaCalls          Int      @default(0) @map("nvidia_calls")
  serpapiCalls         Int      @default(0) @map("serpapi_calls")
  processingCost       Float    @default(0.0) @map("processing_cost")
  visionResults        Json?    @map("vision_results")
  openrouterResults    Json?    @map("openrouter_results")
  nvidiaFallbackUsage  Boolean  @default(false) @map("nvidia_fallback_usage")
  shoppingResultsCount Int      @default(0) @map("shopping_results_count")
  errorMessages        String?  @map("error_messages")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("video_processing_logs")
}

model Poll {
  id        String       @id @default(cuid())
  postId    String       @unique
  expiresAt DateTime
  options   PollOption[]
  votes     PollVote[]
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("polls")
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@map("poll_options")
}

model PollVote {
  id       String     @id @default(cuid())
  optionId String
  userId   String
  pollId   String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
  @@map("poll_votes")
}

model PostView {
  id            String   @id @default(cuid())
  postId        String
  userId        String?
  ip            String?
  watchDuration Int?
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_views")
}

model Repost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("reposts")
}

model PostMention {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_mentions")
}

model DraftPost {
  id          String   @id @default(cuid())
  userId      String
  content     String?
  attachments Json?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("draft_posts")
}

model SavedCollection {
  id        String                @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime              @default(now())
  items     SavedCollectionItem[]
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("saved_collections")
}

model SavedCollectionItem {
  id           String          @id @default(cuid())
  collectionId String
  postId       String
  createdAt    DateTime        @default(now())
  collection   SavedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  post         Post            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([collectionId, postId])
  @@map("saved_collection_items")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model PriceHistory {
  id              String        @id @default(cuid())
  shoppingMatchId String        @map("shopping_match_id")
  price           Float
  capturedAt      DateTime      @default(now()) @map("captured_at")
  shoppingMatch   ShoppingMatch @relation(fields: [shoppingMatchId], references: [id], onDelete: Cascade)

  @@map("price_histories")
}

model ProductCollection {
  id          String                  @id @default(cuid())
  name        String
  userId      String
  createdAt   DateTime                @default(now()) @map("created_at")
  description String?                 @map("description")
  coverImage  String?                 @map("cover_image")
  isPublic    Boolean                 @default(true) @map("is_public")
  featured    Boolean                 @default(false) @map("featured")
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at")
  items       ProductCollectionItem[]
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    DetectedProduct[]       @relation("DetectedProductToProductCollection")

  @@unique([userId, name])
  @@map("product_collections")
}

model ProductCollectionItem {
  id           String            @id @default(cuid())
  collectionId String            @map("collection_id")
  productId    String            @map("product_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      DetectedProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("product_collection_items")
}

model ProductAssignment {
  id                 String             @id @default(cuid())
  postId             String             @map("post_id")
  productId          String             @map("product_id")
  assignedById       String?            @map("assigned_by_id")
  displayOrder       Int                @default(0) @map("display_order")
  featured           Boolean            @default(false) @map("featured")
  status             ProductStatus      @default(PENDING_REVIEW) @map("status")
  verificationSource VerificationSource @default(AI_DETECTED) @map("verification_source")
  sourceType         SourceType         @default(AI_DETECTED) @map("source_type")
  manuallyAssigned   Boolean            @default(false) @map("manually_assigned")
  reviewReason       String?            @map("review_reason")
  aiConfidence       Float?             @map("ai_confidence")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  productType        ProductType        @default(FEATURED) @map("product_type")
  productSource      ProductSource      @default(AI) @map("product_source")
  assignedBy         User?              @relation("AssignedProducts", fields: [assignedById], references: [id])
  post               Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  product            DetectedProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  events             ProductEvent[]

  @@unique([postId, productId])
  @@map("product_assignments")
}

model ProductEvent {
  id           String             @id @default(cuid())
  productId    String             @map("product_id")
  assignmentId String?            @map("assignment_id")
  userId       String?            @map("user_id")
  eventType    ProductEventType   @map("event_type")
  metadata     Json?              @map("metadata")
  createdAt    DateTime           @default(now()) @map("created_at")
  assignment   ProductAssignment? @relation(fields: [assignmentId], references: [id])
  product      DetectedProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id])

  @@map("product_events")
}

model Merchant {
  id              String          @id @default(cuid())
  name            String          @unique
  logoUrl         String?         @map("logo_url")
  rating          Float?
  reviews         Int?
  createdAt       DateTime        @default(now()) @map("created_at")
  shoppingMatches ShoppingMatch[]

  @@map("merchants")
}

model Brand {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String?       @unique
  logoUrl      String?       @map("logo_url")
  description  String?
  featured     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  campaigns    Campaign[]
  shopProducts ShopProduct[]

  @@map("brands")
}

model Campaign {
  id               String         @id @default(cuid())
  brandId          String         @map("brand_id")
  creatorId        String         @map("creator_id")
  name             String
  status           CampaignStatus @default(DRAFT)
  commissionRate   Float?         @default(0) @map("commission_rate")
  commissionEarned Float?         @default(0) @map("commission_earned")
  createdAt        DateTime       @default(now()) @map("created_at")
  brand            Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator          User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("campaigns")
}

model LocationCache {
  id          String   @id @default(cuid())
  latRounded  Float    @map("lat_rounded")
  lngRounded  Float    @map("lng_rounded")
  osmId       String?  @map("osm_id")
  displayName String   @map("display_name")
  city        String?
